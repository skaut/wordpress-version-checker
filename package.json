{
  "name": "wordpress-version-checker",
  "version": "2.2.3",
  "description": "A GitHub app to automatically create issues when a plugin \"tested up to\" version doesn't match the latest WordPress version.",
  "keywords": [
    "wordpress",
    "plugin",
    "github app",
    "automation",
    "version check"
  ],
  "homepage": "https://github.com/skaut/wordpress-version-checker#readme",
  "bugs": {
    "url": "https://github.com/skaut/wordpress-version-checker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaut/wordpress-version-checker.git"
  },
  "license": "MIT",
  "author": "Marek Dědič",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "sideEffects": true,
  "files": [
    "action.yml",
    "app.yml",
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "vite build",
    "check": "run-p -c --aggregate-output check:*",
    "check:js-compat": "es-check es2024 --module --checkFeatures 'dist/**/*.js'",
    "clean": "rimraf dist/*",
    "lint": "run-p -c --aggregate-output lint:*",
    "lint:eslint": "eslint --color",
    "lint:typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks",
    "test": "vitest run --coverage",
    "test-watch": "vitest"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/pre-commit.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "compare-versions": "^6.1.1",
    "ts-custom-error": "^3.3.1"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "es-check": "^9.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-prefer-arrow-functions": "^3.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "mocked-env": "^1.3.5",
    "nock": "^14.0.17",
    "node-fetch": "^3.3.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
